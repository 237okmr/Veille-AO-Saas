# API_URL: URL du script Google Apps Script Web App déployé (ex: https://script.google.com/macros/s/AKfycb.../exec)
API_URL="https://script.google.com/macros/s/VOTRE_DEPLOYMENT_ID/exec"

# PORT: Port du serveur backend Node.js (par défaut 3000)
PORT=3000

# APP_URL: Injecté automatiquement par AI Studio lors du déploiement Cloud Run
APP_URL="http://localhost:3000"


# GOOGLE_CLIENT_ID: identifiant client OAuth (type application Web) pour la connexion administrateur par Google. Public par nature.
GOOGLE_CLIENT_ID=""

# GOOGLE_ADMIN_SECRET: secret dédié partagé avec la propriété du script GOOGLE_ADMIN_SECRET (créé par saasGoogleGenererSecret). Ne jamais le coller ailleurs que dans les Secrets.
GOOGLE_ADMIN_SECRET=""
