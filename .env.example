# API_URL: URL du script Google Apps Script Web App déployé (ex: https://script.google.com/macros/s/AKfycb.../exec)
API_URL="https://script.google.com/macros/s/VOTRE_DEPLOYMENT_ID/exec"

# PORT: Port du serveur backend Node.js (par défaut 3000)
PORT=3000

# APP_URL: Injecté automatiquement par AI Studio lors du déploiement Cloud Run
APP_URL="http://localhost:3000"

